{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "~api/*": ["./api/*"]
    }
  },
  "include": ["api/**/*", "shared/**/*", "vitest.config.ts"]
}
